# Copy to /etc/loadplanner.env on the EC2 host (never commit real secrets).
# Staging/production: point DB_* at your dedicated MySQL server.

APP_NAME=Loadplanner
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_EC2_PUBLIC_DNS
FRONTEND_URL=http://YOUR_EC2_PUBLIC_DNS

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=YOUR_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=loadplanner
DB_USERNAME=loadplanner
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

RUN_MIGRATIONS=true

SANCTUM_STATEFUL_DOMAINS=YOUR_EC2_PUBLIC_DNS
